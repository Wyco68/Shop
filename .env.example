APP_NAME=E-Commerce
STORE_NAME="${APP_NAME}"
CURRENCY=USD
CURRENCY_SYMBOL=$
APP_ENV=local
# Generate after clone: php artisan key:generate (see README Quick Start)
APP_KEY=
# Local development only — production MUST use APP_DEBUG=false (see README Production Security)
APP_DEBUG=true
APP_URL=http://localhost

WWWGROUP=1000
WWWUSER=1000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=ecommerce
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=pusher
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# Local Sail Redis (use REDIS_URL on Render — see .env.render.example)
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
# REDIS_URL=rediss://default:password@endpoint.upstash.io:6379
# REDIS_CLIENT=predis

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1
PUSHER_SCHEME=https
PUSHER_PORT=443

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"

# Mail — verification + password reset (queued; requires queue worker running)
# Local dev: MAIL_MAILER=log writes to storage/logs/laravel.log
# Gmail VPS example:
#   MAIL_MAILER=smtp
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_USERNAME=you@gmail.com
#   MAIL_PASSWORD="16-char-google-app-password"
#   MAIL_FROM_ADDRESS="you@gmail.com"
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Auth token lifetimes (optional overrides; defaults shown)
# AUTH_PASSWORD_TIMEOUT=10800
# Signed email-verification links expire after 60 minutes (config/auth.php)

# Administrator password security (web + CLI)
ADMIN_PASSWORD_WEB_CHANGE_ENABLED=true
ADMIN_PASSWORD_RESET_ENABLED=true
ADMIN_PASSWORD_CHANGE_COOLDOWN_MINUTES=60
ADMIN_PASSWORD_MAX_ATTEMPTS=3
ADMIN_PASSWORD_RATE_LIMIT_MINUTES=15
ADMIN_PASSWORD_CHECK_BREACHED=true

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Host port mapped to MySQL (3307 avoids conflict with a local MySQL on 3306)
# Do not expose DB/Redis ports publicly in production — use private networking only.
FORWARD_DB_PORT=3307
# Host port mapped to Redis (6380 avoids conflict with a local Redis on 6379)
FORWARD_REDIS_PORT=6380

VITE_APP_NAME="${APP_NAME}"

FILESYSTEM_PRODUCT_DISK=public
FILESYSTEM_PRIVATE_DISK=private

# Optional one-time admin password reset (CLI: php artisan admin:env-password-reset)
# ADMIN_RESET_PASSWORD=false
# ADMIN_RESET_EMAIL=admin@example.com
# ADMIN_RESET_PASSWORD_NEW=
