# Reverse proxy for the VPS stack, behind Cloudflare.
# TLS is manual, not automatic: this domain is proxied through Cloudflare (orange cloud), which
# terminates Let's Encrypt's HTTP-01/TLS-ALPN-01 challenges at its edge, so Caddy's automatic
# HTTPS can never complete. Instead certbot (running on the host, via the dns-cloudflare plugin)
# issues the cert into /etc/letsencrypt, which is bind-mounted read-only into this container —
# see DEPLOYMENT.md "Phase 6" for setup and renewal.
{$SITE_ADDRESS} {
	tls /etc/letsencrypt/live/{$SITE_ADDRESS}/fullchain.pem /etc/letsencrypt/live/{$SITE_ADDRESS}/privkey.pem

	reverse_proxy app:8080
	encode gzip

	@build path /build/*
	header @build Cache-Control "public, max-age=31536000, immutable"
}
