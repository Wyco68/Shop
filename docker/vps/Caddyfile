# Reverse proxy + automatic HTTPS for the VPS stack.
# SITE_ADDRESS defaults to plain HTTP on :80 (works on a bare IP, no domain needed).
# Set SITE_ADDRESS=yourdomain.com in .env to get free auto-renewing HTTPS via Let's Encrypt
# (the domain's DNS A/AAAA record must already point at this server).
{$SITE_ADDRESS::80} {
	reverse_proxy app:8080
	encode gzip

	@build path /build/*
	header @build Cache-Control "public, max-age=31536000, immutable"
}
