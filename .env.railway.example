# Railway environment — used by railway.sh / `railway variables --set`.
# Note: like .env.vps.example, this file does NOT support ${OTHER_VAR} expansion — values are
# written literally. Railway's own variable-reference syntax (${{Service.VAR}}) is a different,
# dashboard/control-plane-evaluated mechanism — see the DB_* note below.

APP_NAME=E-Commerce
STORE_NAME=E-Commerce
CURRENCY=USD
CURRENCY_SYMBOL=$
APP_ENV=production
APP_DEBUG=false
# Generate with: docker run --rm php:8.4-cli-bookworm php -r "echo 'base64:'.base64_encode(random_bytes(32));"
# (railway.sh does this for you). Never reuse a key from another environment.
APP_KEY=
# Leave blank — railway.sh fills this in from RAILWAY_PUBLIC_DOMAIN after first deploy, or set it
# yourself to https://your-service.up.railway.app / your custom domain.
APP_URL=

LOG_CHANNEL=stderr
LOG_LEVEL=info

# Database: add Railway's MySQL plugin in the dashboard ("+ New" → Database → MySQL), then run
# `railway variables` to see its exact reference variable names (they vary slightly by Railway
# template version, e.g. MYSQLHOST/MYSQLPORT/MYSQLDATABASE/MYSQLUSER/MYSQLPASSWORD) and either:
#   - use the dashboard's "Add Reference" picker on each DB_* variable (recommended, no typos), or
#   - paste the resolved values here for railway.sh to set directly.
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# No Redis (keeps this on the free trial credit / lowest paid tier): file-based sessions,
# database-backed cache (migration already included), jobs run synchronously in-request.
SESSION_DRIVER=file
CACHE_STORE=database
QUEUE_CONNECTION=sync
SESSION_SECURE_COOKIE=true

# Real-time notifications disabled by default. Pusher has its own free tier if you want this —
# set BROADCAST_CONNECTION=pusher and fill in PUSHER_*/VITE_PUSHER_* below.
BROADCAST_CONNECTION=log
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1
PUSHER_SCHEME=https
PUSHER_PORT=443

VITE_PUSHER_APP_KEY=
VITE_PUSHER_APP_CLUSTER=mt1
VITE_PUSHER_SCHEME=https
VITE_APP_NAME=E-Commerce

# Local disk by default — Railway's filesystem is ephemeral across redeploys, so uploads are lost
# on every redeploy. Switch to s3 (fill in AWS_*) if you need uploads to survive redeploys.
FILESYSTEM_DISK=local
FILESYSTEM_PRODUCT_DISK=public
FILESYSTEM_PRIVATE_DISK=private
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

MAIL_MAILER=log
