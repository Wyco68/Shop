APP_NAME=E-Commerce
STORE_NAME=E-Commerce
CURRENCY=USD
CURRENCY_SYMBOL=$
APP_ENV=production
APP_DEBUG=false
# Set in Render dashboard: php artisan key:generate --show (new key per environment)
APP_KEY=
APP_URL=https://your-service.onrender.com

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=mysql
# Set by Render from managed MySQL (or paste credentials)
DB_HOST=
DB_PORT=3306
DB_DATABASE=ecommerce
DB_USERNAME=
DB_PASSWORD=

REDIS_CLIENT=predis
REDIS_URL=

SESSION_DRIVER=redis
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_SECURE_COOKIE=true
RENDER=true

BROADCAST_CONNECTION=pusher
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1
PUSHER_SCHEME=https
PUSHER_PORT=443

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_APP_NAME="${STORE_NAME}"

FILESYSTEM_DISK=s3
FILESYSTEM_PRODUCT_DISK=s3
FILESYSTEM_PRIVATE_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

MAIL_MAILER=log
