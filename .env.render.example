# =============================================================================
# CarPart — paste into Render → Web Service → Environment → "Add from .env"
# After saving: Manual Deploy (rebuild) so VITE_* are baked into JS.
# Docs: docs/HOSTING-RENDER.md · docs/UPSTASH-PUSHER.md
# =============================================================================
# Replace only:
#   APP_URL          → your https://….onrender.com (no trailing slash)
#   REDIS_URL        → full Upstash UPSTASH_REDIS_URL (rediss://…) if enabling Redis
# =============================================================================

APP_NAME=CarPart
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:Ql4SfgKXgU8OLGN3xgEHxR4AKvvCIWfhlUZ54uvkWvE=
APP_URL=https://carpart-0h2h.onrender.com
APP_DEMO_MODE=true

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/database/database.sqlite

REDIS_CLIENT=predis
# Optional Redis (enable by switching CACHE_STORE/SESSION_DRIVER below)
# REDIS_URL=rediss://default:PASTE_UPSTASH_PASSWORD@notable-gull-139839.upstash.io:6379

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
CACHE_STORE=file
QUEUE_CONNECTION=sync
RENDER=true

BROADCAST_CONNECTION=pusher
PUSHER_APP_ID=2162011
PUSHER_APP_KEY=68f1353f55966982acad
PUSHER_APP_SECRET=c3d14786ced1cc498813
PUSHER_APP_CLUSTER=ap1
PUSHER_SCHEME=https
PUSHER_PORT=443

VITE_APP_NAME=CarPart
VITE_PUSHER_APP_KEY=68f1353f55966982acad
VITE_PUSHER_APP_CLUSTER=ap1
VITE_PUSHER_SCHEME=https

FILESYSTEM_DISK=local
MAIL_MAILER=log
