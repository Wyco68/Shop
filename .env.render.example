# Free tier: no managed DB, no Redis, no worker service — see render.yaml for the full rationale.
# Note: Render reads these from the dashboard/render.yaml directly, not from this file at runtime —
# this is a reference template only. It also doesn't expand ${OTHER_VAR} references, so values
# below are written literally rather than as nested refs.
APP_NAME=E-Commerce
STORE_NAME=E-Commerce
CURRENCY=USD
CURRENCY_SYMBOL=$
APP_ENV=production
APP_DEBUG=false
# Set in Render dashboard: php artisan key:generate --show (new key per environment)
# Generate a unique key per environment — never reuse your local APP_KEY.
APP_KEY=
APP_URL=https://your-service.onrender.com

LOG_CHANNEL=stderr
LOG_LEVEL=info
# Production: keep APP_DEBUG=false. Set LOG_LEVEL=warning or error to reduce noise.

# External database — Render has no free managed MySQL/Postgres. Point this at a MySQL (default,
# matches the installed pdo_mysql driver) or Postgres (DB_CONNECTION=pgsql) instance you host
# elsewhere (e.g. a free-tier instance from another provider).
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=ecommerce
DB_USERNAME=
DB_PASSWORD=

# No Redis on free tier: file-based sessions, database-backed cache (migration already included),
# and jobs run synchronously in-request instead of via a background worker.
SESSION_DRIVER=file
CACHE_STORE=database
QUEUE_CONNECTION=sync
SESSION_SECURE_COOKIE=true
RENDER=true

# Real-time notifications disabled by default (no paid add-on required). Pusher has its own free
# tier if you want this — set BROADCAST_CONNECTION=pusher and fill in PUSHER_*/VITE_PUSHER_* below.
BROADCAST_CONNECTION=log
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1
PUSHER_SCHEME=https
PUSHER_PORT=443

VITE_PUSHER_APP_KEY=
VITE_PUSHER_APP_CLUSTER=mt1
VITE_PUSHER_SCHEME=https
VITE_APP_NAME=E-Commerce

# Local disk by default — free web services have ephemeral storage, so uploads are lost on every
# redeploy. Switch to s3 (fill in AWS_*) if you need uploads to survive redeploys.
FILESYSTEM_DISK=local
FILESYSTEM_PRODUCT_DISK=public
FILESYSTEM_PRIVATE_DISK=private
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

MAIL_MAILER=log
