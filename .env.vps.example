# Self-hosted VPS production environment — used by docker-compose.vps.yml.
# Copy to .env.vps, fill in the blanks, then:
#   docker compose -f docker-compose.vps.yml --env-file .env.vps up -d --build
#
# 1. Set up Nginx + certbot on the host for your domain — see DEPLOYMENT.md "Phase 6".
#    (Nginx and TLS are not part of this Docker stack; "app" only publishes 127.0.0.1:8080
#    for the host Nginx to reverse_proxy into.)
# 2. Set a strong DB_PASSWORD.
# 3. Generate APP_KEY (after first build):
#      docker compose -f docker-compose.vps.yml run --rm app php artisan key:generate --show
#    Paste the full "base64:..." value below — never reuse a key from another environment.

# Note: unlike .env.example, this file is read by Docker Compose (env_file), which does
# NOT expand ${OTHER_VAR} references — keep duplicated values below in sync manually.
APP_NAME=E-Commerce
STORE_NAME=E-Commerce
CURRENCY=USD
CURRENCY_SYMBOL=$
APP_ENV=production
APP_DEBUG=false
APP_KEY=
# Your domain over https, e.g. https://carpart.example.com — must match the Nginx server_name.
APP_URL=

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=ecommerce
DB_USERNAME=ecommerce
DB_PASSWORD=

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

SESSION_DRIVER=redis
CACHE_STORE=redis
QUEUE_CONNECTION=redis
# Requires real HTTPS, which this stack always serves once certbot's cert is in place —
# leaving this true with no HTTPS breaks /setup's CSRF token and login.
SESSION_SECURE_COOKIE=true

# Files (uploads) are stored on the local "app-storage" volume, not S3.
# Switch to s3 by setting these to "s3" and filling in AWS_* below.
FILESYSTEM_DISK=local
FILESYSTEM_PRODUCT_DISK=public
FILESYSTEM_PRIVATE_DISK=private

# Real-time notifications. Use a Pusher account, or set BROADCAST_CONNECTION=log to disable.
BROADCAST_CONNECTION=pusher
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1
PUSHER_SCHEME=https
PUSHER_PORT=443

# Must match PUSHER_APP_KEY/CLUSTER/SCHEME above — baked into the JS bundle at build time.
VITE_PUSHER_APP_KEY=
VITE_PUSHER_APP_CLUSTER=mt1
VITE_PUSHER_SCHEME=https
VITE_APP_NAME=E-Commerce

# Optional: only needed if FILESYSTEM_DISK=s3 above.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

# Outgoing mail (verification, password reset). MAIL_MAILER=log writes to storage/logs only.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME=E-Commerce
