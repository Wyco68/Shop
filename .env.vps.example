# Self-hosted VPS production environment — used by docker-compose.vps.yml.
# Copy to .env.vps, fill in the blanks, then:
#   docker compose -f docker-compose.vps.yml --env-file .env.vps up -d --build
#
# 1. Set up Nginx + certbot on the host for your domain — see DEPLOYMENT.md "Phase 6".
#    (Nginx and TLS are not part of this Docker stack; "app" only publishes 127.0.0.1:8080
#    for the host Nginx to reverse_proxy into.)
# 2. Set a strong DB_PASSWORD.
# 3. Generate APP_KEY (after first build):
#      docker compose -f docker-compose.vps.yml run --rm app php artisan key:generate --show
#    Paste the full "base64:..." value below — never reuse a key from another environment.

# Note: unlike .env.example, this file is read by Docker Compose (env_file), which does
# NOT expand ${OTHER_VAR} references — keep duplicated values below in sync manually.
APP_NAME=E-Commerce
STORE_NAME=E-Commerce
CURRENCY=USD
CURRENCY_SYMBOL=$
APP_ENV=production
APP_DEBUG=false
APP_KEY=
# Your domain over https, e.g. https://carpart.example.com — must match the Nginx server_name.
APP_URL=

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=ecommerce
DB_USERNAME=ecommerce
DB_PASSWORD=

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

SESSION_DRIVER=redis
CACHE_STORE=redis
QUEUE_CONNECTION=redis
# Requires real HTTPS, which this stack always serves once certbot's cert is in place —
# leaving this true with no HTTPS breaks /setup's CSRF token and login.
SESSION_SECURE_COOKIE=true

# Files (uploads) are stored on the local "app-storage" volume, not S3.
# Switch to s3 by setting these to "s3" and filling in AWS_* below.
FILESYSTEM_DISK=local
FILESYSTEM_PRODUCT_DISK=public
FILESYSTEM_PRIVATE_DISK=private

# Real-time notifications via a self-hosted Laravel Reverb server (the "reverb" container) —
# or set BROADCAST_CONNECTION=log to disable. REVERB_APP_ID/KEY/SECRET are credentials this
# server checks itself, not a third-party account — generate random values, e.g.:
#   openssl rand -hex 16
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Internal Docker service name/port — how the "app" container reaches "reverb" directly,
# without round-tripping through Nginx/the public domain.
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

# Public-facing values baked into the JS bundle at build time — VITE_REVERB_APP_KEY must equal
# REVERB_APP_KEY above; HOST must be the real domain, since the browser connects over wss://
# through Nginx's /app/ proxy (see docker/vps/nginx.conf.example).
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https
VITE_APP_NAME=E-Commerce

# Optional: only needed if FILESYSTEM_DISK=s3 above.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

# Outgoing mail (verification, password reset, order status updates). MAIL_MAILER=log writes to
# storage/logs only — set to resend to send real email via Resend (resend.com). RESEND_API_KEY
# comes from the Resend dashboard; MAIL_FROM_ADDRESS must be on the domain you verified there
# (the DKIM/SPF/DMARC DNS records Resend gave you) or sends will be rejected.
MAIL_MAILER=resend
RESEND_API_KEY=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME=E-Commerce
